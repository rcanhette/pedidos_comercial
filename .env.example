SQLITE_DATABASE_URL="file:./data/pedidos.db"
DATABASE_URL="postgresql://sistema_pedidos:substitua-por-uma-senha-segura@localhost:5433/sistema_pedidos?schema=public"
TEST_DATABASE_URL="postgresql://sistema_pedidos:substitua-por-uma-senha-segura@localhost:5433/sistema_pedidos_test?schema=public"
POSTGRES_DB="sistema_pedidos"
POSTGRES_USER="sistema_pedidos"
POSTGRES_PASSWORD="substitua-por-uma-senha-segura"
SESSION_SECRET="troque-por-uma-chave-com-no-minimo-32-caracteres"
ADMIN_INITIAL_PASSWORD="DefinaUmaSenhaForte#123"
APP_TIMEZONE="America/Sao_Paulo"
NEXT_PUBLIC_APP_NAME="Coonagro Business Intelligence"

# URL pública exata usada pelos callbacks OAuth, sem barra final.
AUTH_BASE_URL="https://seu-dominio.com.br"

# Em produção com HTTPS, use true para cookies seguros.
SESSION_COOKIE_SECURE="true"

# Google OAuth. Callback: https://seu-dominio.com.br/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft/Office 365 OAuth. Callback: https://seu-dominio.com.br/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# SMTP usado para enviar o código de dupla autenticação por e-mail.
SMTP_HOST="smtp.seu-provedor.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_USER="usuario-smtp"
SMTP_PASSWORD="senha-smtp"
SMTP_FROM="Coonagro Business Intelligence <no-reply@seu-dominio.com.br>"
SMTP_HELO="seu-dominio.com.br"

# Validação avançada de destinatário por SMTP. Use false se o provedor bloquear RCPT TO externo.
EMAIL_VALIDATION_SMTP="false"
EMAIL_VALIDATION_SMTP_TIMEOUT_MS="5000"
EMAIL_VALIDATION_FROM="postmaster@seu-dominio.com.br"
