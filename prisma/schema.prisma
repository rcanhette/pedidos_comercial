generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  username            String               @unique
  email               String               @unique
  phone               String
  cpf                 String?              @unique
  position            String?
  passwordHash        String
  active              Boolean              @default(true)
  mustChangePassword  Boolean              @default(false)
  lastAccessAt        DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  roles               UserRole[]
  permissions         UserPermission[]
  createdOrders       Order[]              @relation("OrderCreator")
  lastChangedOrders   Order[]              @relation("OrderLastChangedBy")
  statusHistories     OrderStatusHistory[]
  changeHistories     OrderChangeHistory[]
  auditLogs           AuditLog[]
  updatedSalesTargets SalesTarget[]        @relation("SalesTargetUpdatedBy")
  sessions            Session[]
  loginChallenges     LoginChallenge[]
}

model LoginChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  codeHash   String
  userId     String
  email      String
  provider   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  users       UserPermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  effect       String     @default("ALLOW")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  city      String
  cnpj      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([active])
  @@index([name])
  @@index([city])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  unit        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([active])
  @@index([name])
}

model ContractType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([active])
  @@index([name])
}

model RawMaterialClosing {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([active])
  @@index([name])
}

model RawMaterial {
  id         String             @id @default(cuid())
  name       String             @unique
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  orderItems OrderRawMaterial[]

  @@index([active])
  @@index([name])
}

model SalesResponsible {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([active])
  @@index([name])
}

model Package {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  capacityScaled Int?
  unit           String?
  weightScaled   Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@index([active])
  @@index([name])
}

model Currency {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  symbol        String
  decimalPlaces Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([active])
  @@index([code])
}

model OrderNumberSequence {
  year  Int @id
  value Int
}

model Order {
  id                             String               @id @default(cuid())
  sequentialId                   Int                  @unique @default(autoincrement())
  number                         String               @unique
  representativeId               String
  representativeName             String
  createdById                    String
  customerId                     String?
  salesResponsibleId             String?
  salesResponsibleNameSnapshot   String?
  contractTypeId                 String?
  contractTypeNameSnapshot       String?
  rawMaterialClosingId           String?
  rawMaterialClosingNameSnapshot String?
  solicitationAt                 DateTime             @default(now())
  customerName                   String
  city                           String
  cnpj                           String
  productId                      String
  productNameSnapshot            String
  productUnitSnapshot            String
  quantityScaled                 Int
  packageId                      String
  packageNameSnapshot            String
  currencyId                     String
  currencyCodeSnapshot           String
  currencySymbolSnapshot         String
  unitPriceCents                 Int
  dollarRateScaled               Int?
  dollarRateText                 String?
  paymentTerms                   String
  commissionUsdCents             Int?
  paymentDate                    DateTime?
  pickupForecast                 DateTime?
  freightCents                   Int?
  freightText                    String?
  notes                          String?
  sapOrderNumber                 String?
  status                         String               @default("RECEBIDO")
  cancelledAt                    DateTime?
  cancellationReason             String?
  lastChangedById                String
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  createdBy                      User                 @relation("OrderCreator", fields: [createdById], references: [id])
  lastChangedBy                  User                 @relation("OrderLastChangedBy", fields: [lastChangedById], references: [id])
  customer                       Customer?            @relation(fields: [customerId], references: [id])
  salesResponsible               SalesResponsible?    @relation(fields: [salesResponsibleId], references: [id])
  product                        Product              @relation(fields: [productId], references: [id])
  package                        Package              @relation(fields: [packageId], references: [id])
  currency                       Currency             @relation(fields: [currencyId], references: [id])
  statusHistory                  OrderStatusHistory[]
  changeHistory                  OrderChangeHistory[]
  contractType                   ContractType?        @relation(fields: [contractTypeId], references: [id])
  rawMaterialClosing             RawMaterialClosing?  @relation(fields: [rawMaterialClosingId], references: [id])
  technicalClosingItems          OrderRawMaterial[]

  @@index([number])
  @@index([sapOrderNumber])
  @@index([createdById])
  @@index([customerId])
  @@index([salesResponsibleId])
  @@index([contractTypeId])
  @@index([rawMaterialClosingId])
  @@index([representativeId])
  @@index([status])
  @@index([customerName])
  @@index([cnpj])
  @@index([productId])
  @@index([currencyId])
  @@index([currencyCodeSnapshot])
  @@index([solicitationAt])
  @@index([pickupForecast])
}

model OrderRawMaterial {
  id                      String      @id @default(cuid())
  orderId                 String
  rawMaterialId           String
  rawMaterialNameSnapshot String
  quantityKgScaled        Int
  quantityTonsScaled      Int
  priceCents              Int?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  order                   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rawMaterial             RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([orderId, rawMaterialId])
  @@index([orderId])
  @@index([rawMaterialId])
}

model OrderStatusHistory {
  id             String   @id @default(cuid())
  orderId        String
  previousStatus String?
  newStatus      String
  changedById    String
  changedAt      DateTime @default(now())
  justification  String?
  ipAddress      String?
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy      User     @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@index([changedAt])
}

model OrderChangeHistory {
  id          String   @id @default(cuid())
  orderId     String
  changedById String
  changedAt   DateTime @default(now())
  field       String
  oldValue    String?
  newValue    String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@index([changedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String?
  entityId   String?
  userId     String?
  createdAt  DateTime @default(now())
  beforeData String?
  afterData  String?
  ipAddress  String?
  userAgent  String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model SalesTarget {
  id                     String   @id @default(cuid())
  year                   Int
  month                  Int
  targetTonsScaled       Int
  manualActualTonsScaled Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  updatedById            String?
  updatedBy              User?    @relation("SalesTargetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([year, month])
  @@index([year])
  @@index([updatedById])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
